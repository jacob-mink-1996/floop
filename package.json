{
  "name": "@floop/product",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace services/api run dev",
    "dev:web": "npm --workspace apps/web-react run dev",
    "dev:electron": "npm --workspace apps/electron run dev",
    "build:web": "npm --workspace apps/web-react run build",
    "build:electron": "npm --workspace apps/electron run build",
    "bootstrap:project": "node scripts/bootstrap-project.mjs",
    "agent:message": "node scripts/floop-agent-message.mjs",
    "mcp:server": "node scripts/floop-mcp-server.mjs",
    "demo:live": "node scripts/demo-live-flow.mjs",
    "demo:proof": "npm run build:web && node scripts/record-usage-demo.mjs",
    "demo:proof:keep": "FLOOP_DEMO_KEEP_FIXTURE=true npm run demo:proof",
    "demo:record": "npm run build:web && node scripts/record-usage-demo.mjs --record",
    "demo:record:open": "npm run build:web && node scripts/record-usage-demo.mjs --record --open",
    "demo:refinement": "npm run build:web && node scripts/record-refinement-demo.mjs",
    "demo:refinement:record": "npm run build:web && node scripts/record-refinement-demo.mjs --record",
    "demo:refinement:record:open": "npm run build:web && node scripts/record-refinement-demo.mjs --record --open",
    "demo:big-work": "npm run demo:big-work:codex",
    "demo:big-work:record": "npm run demo:big-work:codex:record",
    "demo:big-work:record:open": "npm run demo:big-work:codex:record:open",
    "demo:big-work:codex": "npm run build:web && node scripts/record-big-work-demo.mjs --codex",
    "demo:big-work:codex:record": "npm run build:web && node scripts/record-big-work-demo.mjs --codex --record",
    "demo:big-work:codex:record:open": "npm run build:web && node scripts/record-big-work-demo.mjs --codex --record --open",
    "demo:big-work:fixture": "npm run build:web && node scripts/record-big-work-demo.mjs --fixture-agents",
    "demo:big-work:fixture:record": "npm run build:web && node scripts/record-big-work-demo.mjs --fixture-agents --record",
    "demo:new-features": "npm run demo:new-features:fixture",
    "demo:new-features:fixture": "npm run build:web && node scripts/record-big-work-demo.mjs --fixture-agents",
    "demo:new-features:fixture:record": "npm run build:web && node scripts/record-big-work-demo.mjs --fixture-agents --record",
    "demo:new-features:codex": "npm run build:web && node scripts/record-big-work-demo.mjs --codex",
    "demo:new-features:codex:record": "npm run build:web && node scripts/record-big-work-demo.mjs --codex --record",
    "demo:new-features:codex:record:open": "npm run build:web && node scripts/record-big-work-demo.mjs --codex --record --open",
    "proof:review-rework-loop": "node scripts/proof-review-rework-loop.mjs",
    "proof:merge-rework:codex": "node scripts/proof-merge-rework-codex.mjs",
    "verify:mvp": "node scripts/verify-mvp-live.mjs",
    "verify:mvp2": "node scripts/verify-mvp2-release.mjs",
    "verify:mvp2:plan": "node scripts/verify-mvp2-release.mjs --dry-run",
    "verify:mvp2:codex": "node scripts/verify-mvp2-release.mjs --require-codex",
    "start": "npm --workspace services/api run start",
    "start:workers": "npm --workspace services/api run start:workers",
    "start:worker:execution": "npm --workspace services/api run start:worker:execution",
    "start:worker:merge": "npm --workspace services/api run start:worker:merge",
    "start:worker:ceremony-automation": "npm --workspace services/api run start:worker:ceremony-automation",
    "start:worker:ceremony-participant": "npm --workspace services/api run start:worker:ceremony-participant",
    "start:web": "npm --workspace apps/web-react run preview",
    "start:electron": "npm --workspace apps/electron run start",
    "check": "npm run build:web && node scripts/check-types.mjs",
    "check:electron": "npm --workspace apps/electron run check",
    "check:ui": "npm run build:web && node scripts/check-react-ui-browser.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
